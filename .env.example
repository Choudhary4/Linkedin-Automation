# LinkedIn Credentials
# Your LinkedIn email address
LINKEDIN_EMAIL=skuntal310@gmail.com

# Your LinkedIn password
LINKEDIN_PASSWORD=Saurabh@420

# Application Configuration
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Browser Configuration
# Set to true to run browser in headless mode (no visible window)
HEADLESS=false

# Slow motion in milliseconds (useful for debugging, 0 for no slow motion)
SLOW_MOTION=0

# Connection Request Settings
# Maximum connection requests to send per day
MAX_CONNECTIONS_PER_DAY=20

# Maximum connection requests per hour
MAX_CONNECTIONS_PER_HOUR=5

# Messaging Settings
# Maximum messages to send per day
MAX_MESSAGES_PER_DAY=15

# Default message template (supports {firstName}, {lastName}, {company} variables)
DEFAULT_MESSAGE_TEMPLATE=Hi {firstName}, I'd love to connect with you!

# Search Configuration
# Default search keywords (comma-separated)
DEFAULT_SEARCH_KEYWORDS=Software Engineer,Product Manager

# Default location filter
DEFAULT_LOCATION=United States

# Stealth Configuration
# Minimum delay between actions in milliseconds
MIN_ACTION_DELAY=2000

# Maximum delay between actions in milliseconds
MAX_ACTION_DELAY=5000

# Enable random scrolling behavior
ENABLE_RANDOM_SCROLL=true

# Enable realistic typing simulation
ENABLE_TYPING_SIMULATION=true

# Enable mouse hovering and movement
ENABLE_MOUSE_HOVER=true

# Operating hours (24-hour format, e.g., 9-17 for 9 AM to 5 PM)
OPERATING_HOURS_START=9
OPERATING_HOURS_END=17

# Database Configuration
# Path to SQLite database file
DATABASE_PATH=./data/subspace.db

# Session Configuration
# Path to store session cookies
SESSION_PATH=./data/sessions
